# VisorUp Agent System — Environment Variables
# Copy this to .env and fill in values

# ── Google OAuth (GA4 + Search Console) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ── GA4 ──
GA4_PROPERTY_ID=

# ── Search Console ──
SEARCH_CONSOLE_SITE_URL=https://visorup.co.uk
SITE_URL=https://visorup.co.uk
SITEMAP_URL=https://visorup.co.uk/sitemap.xml

# ── Anthropic (Claude — content generation) ──
ANTHROPIC_API_KEY=

# ── Gemini (Image generation) ──
GEMINI_API_KEY=

# ── GitHub (repo write access for content agents) ──
GITHUB_TOKEN=
GITHUB_REPO=GlobalBookings/visorup

# ── App Store Connect (app downloads, proceeds, reviews) ──
# App Store Connect > Users and Access > Integrations > App Store Connect API
ASC_ISSUER_ID=
ASC_KEY_ID=
# Paste the AuthKey_XXXX.p8 contents. Use \n for newlines if kept on one line.
ASC_PRIVATE_KEY=
# Payments and Financial Reports > vendor number (digits only)
ASC_VENDOR_NUMBER=
# Numeric Apple ID of the app (App Store Connect > App > App Information)
ASC_APP_ID=

# ── Supabase (app signups / rides / routes) ──
SUPABASE_URL=https://wqrazxstxiaahejsdurj.supabase.co
# Service-role key (Project Settings > API). Keep secret — bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ── Slack (webhook for reports) ──
SLACK_WEBHOOK_URL=

# ── Server ──
APPROVAL_PORT=3100
LOG_LEVEL=info
